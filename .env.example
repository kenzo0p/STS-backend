# Copy this file to .env.development.local and fill in your values.
# For production, copy to .env.production.local and set NODE_ENV=production.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/subscriptionDB
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
DB_URI=mongodb://localhost:27017/subscriptionDB

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random string in production. Never commit the real secret.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Arcjet (rate limiting & bot detection) ────────────────────────────────────
# Obtain from https://app.arcjet.com
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development

# ─── Upstash QStash (background workflows / reminder emails) ───────────────────
# Obtain from https://console.upstash.com/qstash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_key

# Public URL that Upstash will POST reminders back to.
# Use a tunnel (e.g., ngrok) for local development.
SERVER_URL=http://localhost:3000

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your regular account password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
